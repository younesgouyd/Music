getAll:
SELECT * FROM import_session;

get:
SELECT * FROM import_session WHERE id = :id;

getOldestPending:
SELECT * FROM import_session
WHERE state = 'Pending'
ORDER BY creation_datetime ASC
LIMIT 1;

getOngoingImportsCount:
SELECT COUNT(*) FROM import_session WHERE state IN ('Pending', 'Started');

add:
INSERT INTO import_session (uri, source_type, domain_name, state, creation_datetime, update_datetime)
VALUES (:uri, :source_type, :domain_name, :state, :creation_datetime, :update_datetime);

updateState:
UPDATE import_session
SET state = :state,
    update_datetime = :update_datetime
WHERE id = :id;

delete:
DELETE FROM import_session WHERE id = :id;
